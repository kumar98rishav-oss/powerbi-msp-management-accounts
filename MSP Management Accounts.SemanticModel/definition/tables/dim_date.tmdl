		sortByColumn: MonthYearKey

		annotation SummarizationSetBy = Automatic

	column MonthYearKey = dim_date[Year] * 100 + dim_date[MonthNo]
		dataType: int64
		isHidden
		lineageTag: f958a674-c655-4d3f-8137-e64fa356303b

	hierarchy 'Date Hierarchy'
		lineageTag: 3711a6b2-9ac7-4b9f-b8da-0c04743c055f

		level Date
			lineageTag: 19ce06cd-1486-4f36-81f0-482a5f540c24
			column: Date

		level Day
			lineageTag: 1745e8cf-2949-41d7-a7d0-faaee019d6ae
			column: Day

		level MonthName
			lineageTag: 3f97d179-b721-4c7c-9835-d5401d6f7668
			column: MonthName

		level Quarter
			lineageTag: 6ce035fe-a11b-49c9-8b5c-059224d64226
			column: Quarter

		level MonthYear
			lineageTag: 7b8253d7-5273-45a0-8063-e6fe08ab8862
			column: MonthYear

		level Year
			lineageTag: 07a83fd6-5d33-4509-80bf-37266a9a04a9
			column: Year

		level MonthShort
			lineageTag: 00e0ec1e-a6e1-4ce3-8263-6828e891d2a2
			column: MonthShort

	partition dim_date = calculated
		source = VAR _min = DATE ( YEAR ( MIN ( 'fct_Billing'[Month_start] ) ), 1, 1 ) VAR _maxYear = MAX ( YEAR ( MAX ( 'fct_Billing'[Month_start] ) ), MAX ( 'fct_bs'[year] ) ) VAR _max = DATE ( _maxYear, 12, 31 ) RETURN ADDCOLUMNS ( CALENDAR ( _min, _max ), "Year", YEAR ( [Date] ), "Quarter", "Q" & QUARTER ( [Date] ), "MonthNo", MONTH ( [Date] ), "MonthName", FORMAT ( [Date], "MMMM" ), "MonthShort", FORMAT ( [Date], "MMM" ), "MonthYear", FORMAT ( [Date], "MMM yy" ), "WeekOfYear", WEEKNUM ( [Date], 2 ), "Day", DAY ( [Date] ), "WeekdayNo", WEEKDAY ( [Date], 2 ), "WeekdayName", FORMAT ( [Date], "dddd" ), "IsWeekend", WEEKDAY ( [Date], 2 ) > 5 )

