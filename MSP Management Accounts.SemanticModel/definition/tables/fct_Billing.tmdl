table fct_Billing
	lineageTag: a49747ca-0cca-4fdf-b5c6-55f146955e1d

	measure sample =
			AVERAGEX(
			    FILTER(
			        ALLSELECTED(dim_date),
			        dim_date[Date] >= EOMONTH(MAX(dim_date[Date]), -3) + 1
			    ),
			    CALCULATE(
			        [Revenue (P&L)],
			        FILTER(
			            fct_Billing,
			            fct_Billing[Date] >= EOMONTH(MAX(dim_date[Date]), -3) + 1
			        )
			    )
			)
		formatString: \$#,##0
		displayFolder: Metrics
		lineageTag: 954262ae-5c50-4d00-916a-c741a70efba0

