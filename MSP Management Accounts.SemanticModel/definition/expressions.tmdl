expression fnCleanMoney =
		let
		    Source = (input as any) as nullable number =>
		let
		    txt   = if input = null then null else Text.Trim(Text.From(input)),
		    empty = txt = null or List.Contains({"", "null", "NA", "N/A", "n/a", "-"}, txt),
		    out   = if empty then null else
		              let
		                  neg    = Text.StartsWith(txt, "(") or Text.StartsWith(txt, "-"),
		                  digits = Text.Select(txt, {"0".."9", "."}),
		                  number = try Number.From(digits) otherwise null,
		                  signed = if number = null then null else if neg then -number else number
		              in  signed
		in
		    out
		in
		    Source
	lineageTag: fe4e6af3-9ff6-4ab2-b770-17054a39cbe1

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnParseCompact =
		let
		    Source = (input as any) as nullable number =>
		let
		    txt = if input = null then null else Text.Upper(Text.Trim(Text.From(input))),
		    out = if txt = null or txt = "" then null else
		            let
		                neg  = Text.StartsWith(txt, "-"),
		                mult = if Text.EndsWith(txt, "M") then 1000000 else if Text.EndsWith(txt, "K") then 1000 else 1,
		                core = Text.Select(txt, {"0".."9", "."}),
		                num  = try Number.From(core) * mult otherwise null
		            in  if num = null then null else if neg then -num else num
		in
		    out
		in
		    Source
	lineageTag: e780b868-0df3-414e-b78d-0b9ef1a627f8

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnParseDate =
		let
		    Source = (input as any) as nullable date =>
		let
		    txt   = Text.Trim(Text.From(input)),
		    tries = {
		        try Date.FromText(txt, [Format="yyyy-MM-dd", Culture="en-US"]) otherwise null,
		        try Date.FromText(txt, [Format="dd/MM/yyyy", Culture="en-GB"]) otherwise null,
		        try Date.FromText(txt, [Format="MMM d, yyyy", Culture="en-US"]) otherwise null,
		        try Date.FromText(Text.Replace(txt, ".", "-"), [Format="yyyy-MM-dd", Culture="en-US"]) otherwise null
		    },
		    hit = List.First(List.Select(tries, each _ <> null), null)
		in
		    hit
		in
		    Source
	lineageTag: 23a66f62-0d49-4c10-87be-9fdc99ecaa0b

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnCleanText =
		let
		    Source = (input as any) as nullable text =>
		let
		    txt   = if input = null then null else Text.From(input),
		    clean = if txt = null then null else Text.Trim(Text.Clean(txt)),
		    empty = clean = null or List.Contains({"", "null", "NULL", "NA", "N/A", "n/a", "-"}, clean),
		    out   = if empty then null else clean
		in
		    out
		in
		    Source
	lineageTag: 412a9135-0e0b-4d37-ab5c-c48388aa2644

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnNormalizeText =
		let
		    Source = (input as any) as nullable text =>
		let
		    // Convert to text
		    txt = if input = null then null else Text.From(input),
		
		    // Remove hidden characters and trim
		    clean = if txt = null then null else Text.Trim(Text.Clean(txt)),
		
		    // Convert common placeholders to null
		    empty = clean = null or
		            List.Contains(
		                {"", "null", "NULL", "NA", "N/A", "n/a", "-", "--"},
		                clean
		            ),
		
		    // Collapse multiple spaces into a single space
		    singleSpace =
		        if empty then
		            null
		        else
		            Text.Combine(
		                List.Select(
		                    Text.SplitAny(clean, " "),
		                    each _ <> ""
		                ),
		                " "
		            ),
		
		    // Proper case each word
		    proper =
		        if singleSpace = null then
		            null
		        else
		            Text.Combine(
		                List.Transform(
		                    Text.Split(singleSpace, " "),
		                    each Text.Proper(_)
		                ),
		                " "
		            )
		
		in
		    proper
		in
		    Source
	lineageTag: 9c040c9c-4249-4331-887a-e58f17127346

