	measure 'Unbilled WIP' = ```
			
			VAR d = CALCULATE ( MAX ( fct_bs[Quarter End Date] ), 
			        KEEPFILTERS ( fct_bs[Balance_Sheet_Item] = "Unbilled Revenue (WIP)" ) ) 
			        
