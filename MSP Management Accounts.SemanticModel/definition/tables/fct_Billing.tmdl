	column Date = DATE ( VALUE ( RIGHT ( fct_Billing[Month_start], 4 ) ), VALUE ( LEFT ( fct_Billing[Month_start], FIND ( "/", fct_Billing[Month_start] ) - 1 ) ), 1 )
