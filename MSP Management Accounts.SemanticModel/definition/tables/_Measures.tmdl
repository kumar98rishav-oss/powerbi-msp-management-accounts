	measure 'Last Refreshed' = "As at " & FORMAT ( EOMONTH ( MAX ( fct_Billing[Date] ), 0 ), "dd mmm yyyy" )
		lineageTag: 5de882d4-2693-4f61-b0d7-7f07b99a8324

	measure 'Utilisation Caption' =
			
			FORMAT ( [Billable Hours] / 1000, "#,0" ) & "k billable of "
			    & FORMAT ( [Capacity Hours] / 1000, "#,0" ) & "k capacity hrs"
		formatString: …, "#,0"
		displayFolder: 4 Utilisation
		lineageTag: 917d724c-89dd-4818-95b0-60d38cafa934

		annotation PBI_FormatHint = {"isCustom":true}

	measure '% of Revenue' = DIVIDE ( [Pnl Amount], CALCULATE ( [Revenue (P&L)], REMOVEFILTERS ( fct_pnl[Category], fct_pnl[Line_Item] ) ) )
